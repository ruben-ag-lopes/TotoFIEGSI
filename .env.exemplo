# Copia este ficheiro para .env e preenche com os valores reais.
# O .env esta no .gitignore: nunca vai para o GitHub.
#
# Onde encontrar no Supabase:
#   Project Settings -> Data API  ->  Project URL
#   Project Settings -> API Keys  ->  service_role  (a secreta, NAO a anon)

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=cola-aqui-a-chave-service_role

# Segredo para assinar os cookies de sessao. Gera um novo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=cola-aqui-um-segredo-aleatorio
